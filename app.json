{
  "expo": {
    "name": "Portfolio",
    "slug": "portfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-256.png",
    "scheme": "portfolioapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon-256.png"
    },
    "splash": {
      "image": "./assets/images/icon-256.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-256.png",
        "backgroundColor": "#1a1a1a"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gia22.portfolioapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "26387688-8f09-40ed-b288-851927a3e46a"
      }
    },
    "owner": "gia22"
  }
}
